From 60591084832b212b858a4d13ac7b3f9bc4af9c81 Mon Sep 17 00:00:00 2001
From: Rosen Penev <rosenp@gmail.com>
Date: Thu, 15 Oct 2026 02:33:38 -0700
Subject: [PATCH 5/7] wifi: b43: accept RX block ack sessions with HT enabled

With HT enabled, stations send A-MPDUs once they have set up a block
ack session, and b43 refuses those sessions. Receiving an A-MPDU needs
nothing from the driver: the firmware sends the block ack, and
mac80211 reorders the MPDUs.

Accept RX sessions in a new ampdu_action callback and set
AMPDU_AGGREGATION when HT is enabled. TX aggregation is still not
supported. With firmware older than 598, whose block ack template b43
does not fill in, RX sessions are refused. Advertise an MPDU density of 8 us, as brcmsmac does, and
keep the maximum A-MPDU length at 8 KiB, which the firmware handles
without the shared memory settings brcmsmac writes for longer ones.

Tested on an ASUS RT-N16 as an access point with an Intel 3168 client
on channel 11: TCP from the client to the router goes from 12 Mbit/s
with 802.11g to 21-23 Mbit/s, open and with WPA2 using hardware CCMP.

Assisted-by: LLM
Signed-off-by: Rosen Penev <rosenp@gmail.com>
---
 drivers/net/wireless/broadcom/b43/main.c | 44 ++++++++++++++++++++++--
 1 file changed, 42 insertions(+), 2 deletions(-)

--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -369,12 +369,12 @@ static struct ieee80211_supported_band b43_band_2ghz_limited = {
 	.n_bitrates	= b43_g_ratetable_size,
 };
 
-/* HT20 with one spatial stream and no A-MPDU */
+/* HT20 with one spatial stream, receiving A-MPDUs only */
 #define B43_HT_CAP {							\
 	.ht_supported	= true,						\
 	.cap		= IEEE80211_HT_CAP_SM_PS,			\
 	.ampdu_factor	= IEEE80211_HT_MAX_AMPDU_8K,			\
-	.ampdu_density	= IEEE80211_HT_MPDU_DENSITY_NONE,		\
+	.ampdu_density	= IEEE80211_HT_MPDU_DENSITY_8,			\
 	.mcs = {							\
 		.rx_mask	= { 0xff },				\
 		.tx_params	= IEEE80211_HT_MCS_TX_DEFINED,		\
@@ -5228,6 +5228,43 @@ static void b43_op_sw_scan_complete_notifier(struct ieee80211_hw *hw,
 	mutex_unlock(&wl->mutex);
 }
 
+/* Whether the firmware sends HT frames and block acks */
+static bool b43_ht_fw_loaded(struct b43_wl *wl)
+{
+	struct b43_wldev *dev;
+	bool ret;
+
+	mutex_lock(&wl->mutex);
+	dev = wl->current_dev;
+	ret = dev && dev->fw.hdr_format == B43_FW_HDR_598;
+	mutex_unlock(&wl->mutex);
+
+	return ret;
+}
+
+static int b43_op_ampdu_action(struct ieee80211_hw *hw,
+			       struct ieee80211_vif *vif,
+			       struct ieee80211_ampdu_params *params)
+{
+	struct b43_wl *wl = hw_to_b43_wl(hw);
+
+	switch (params->action) {
+	case IEEE80211_AMPDU_RX_START:
+		/* b43 fills in the block ack template of firmware 598 only */
+		if (!b43_ht_fw_loaded(wl))
+			return -EOPNOTSUPP;
+		fallthrough;
+	case IEEE80211_AMPDU_RX_STOP:
+		/*
+		 * The firmware sends the block acks, and mac80211 reorders
+		 * the frames, so there is nothing to set up.
+		 */
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
 static int b43_op_get_survey(struct ieee80211_hw *hw, int idx,
 			     struct survey_info *survey)
 {
@@ -5310,6 +5347,7 @@ static const struct ieee80211_ops b43_hw_ops = {
 	.stop			= b43_op_stop,
 	.set_tim		= b43_op_beacon_set_tim,
 	.sta_notify		= b43_op_sta_notify,
+	.ampdu_action		= b43_op_ampdu_action,
 	.sw_scan_start		= b43_op_sw_scan_start_notifier,
 	.sw_scan_complete	= b43_op_sw_scan_complete_notifier,
 	.get_survey		= b43_op_get_survey,
@@ -5710,6 +5748,8 @@ static struct b43_wl *b43_wireless_init(struct b43_bus_dev *dev)
 	ieee80211_hw_set(hw, RX_INCLUDES_FCS);
 	ieee80211_hw_set(hw, SIGNAL_DBM);
 	ieee80211_hw_set(hw, MFP_CAPABLE);
+	if (modparam_ht)
+		ieee80211_hw_set(hw, AMPDU_AGGREGATION);
 	hw->wiphy->interface_modes =
 		BIT(NL80211_IFTYPE_AP) |
 		BIT(NL80211_IFTYPE_MESH_POINT) |
